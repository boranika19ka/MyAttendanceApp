<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#1A237E"
        android:padding="20dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ធ្វើការថែមម៉ោង (Overtime)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Form Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="សំណើថែមម៉ោងថ្មី"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E"
                        android:layout_marginBottom="16dp"/>

                    <!-- Date -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ថ្ងៃធ្វើការ"
                        android:textSize="14sp"
                        android:textColor="#555555"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/btnDate"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="ជ្រើសរើសថ្ងៃ"
                        android:textColor="#333333"
                        android:backgroundTint="#F5F5F5"
                        android:layout_marginBottom="16dp"/>

                    <!-- Hours -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ចំនួនម៉ោង"
                        android:textSize="14sp"
                        android:textColor="#555555"
                        android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etHours"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="ឧ: 2.5"
                        android:inputType="numberDecimal"
                        android:padding="12dp"
                        android:background="@drawable/input_background"
                        android:layout_marginBottom="16dp"/>

                    <!-- Reason -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="មូលហេតុ"
                        android:textSize="14sp"
                        android:textColor="#555555"
                        android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etReason"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:hint="សូមបញ្ចូលមូលហេតុ..."
                        android:inputType="textMultiLine"
                        android:gravity="top"
                        android:padding="12dp"
                        android:background="@drawable/input_background"
                        android:layout_marginBottom="24dp"/>

                    <!-- Submit -->
                    <Button
                        android:id="@+id/btnSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="ដាក់សំណើ"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_background"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- My Overtime List -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="សំណើរបស់ខ្ញុំ"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerOvertimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="មិនមានសំណើ!"
                android:textSize="14sp"
                android:textColor="#888888"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>